# Stock Analysis Pro - Environment Configuration
# Copy this to .env and fill in your values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Option 1 (RECOMMENDED): Use a connection string (Supabase, DigitalOcean, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database

# Option 2: Use individual connection parameters (local development)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=stock_analysis
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false
# DB_MAX_CONNECTIONS=10
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=5000

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=production
LOG_LEVEL=info
# PORT is auto-set by cloud platforms (DigitalOcean, Railway, etc.)
# Only set manually for local development:
# PORT=4000
DASHBOARD_ENABLED=true

# Comma-separated list of allowed frontend origins
# Add your production domain here after deployment
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# SCHEDULER CONFIGURATION
# ===========================================
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_CRON=0 9 * * 1-5

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# ===========================================
# NOTIFICATION SETTINGS
# ===========================================
SEND_EMAIL=false
SEND_TELEGRAM=false

# ===========================================
# AI LAYER CONFIGURATION
# ===========================================

# Enable/Disable AI Analysis Layer (set to false to bypass AI completely)
ENABLE_AI_LAYER=true

# Google Gemini API Key for AI Analysis
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# AI Model Configuration
AI_MODEL=gemini-2.0-flash-exp
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# AI Rate Limiting (milliseconds between API calls)
AI_RATE_LIMIT_MS=4500

# AI Confidence Threshold (0-100)
AI_CONFIDENCE_THRESHOLD=70

# ===========================================
# GROQ FALLBACK CONFIGURATION
# ===========================================
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ===========================================
# OPENROUTER FALLBACK CONFIGURATION
# ===========================================
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ===========================================
# PUPPETEER / DOCKER CONFIGURATION
# ===========================================
# Set this when running in Docker or cloud environments
# where Chromium is installed at a custom path
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
