# Stock Analysis Pro - Environment Configuration

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_analysis
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# OR use a full connection string:
# DATABASE_URL=postgresql://user:password@host:5432/database

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=production
LOG_LEVEL=info
DASHBOARD_PORT=4000
DASHBOARD_ENABLED=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# SCHEDULER CONFIGURATION
# ===========================================
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_CRON=0 9 * * 1-5  # 9 AM on weekdays

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# ===========================================
# NOTIFICATION SETTINGS
# ===========================================
SEND_EMAIL=false
SEND_TELEGRAM=false

# ===========================================
# AI LAYER CONFIGURATION
# ===========================================

# Enable/Disable AI Analysis Layer (set to false to bypass AI completely)
ENABLE_AI_LAYER=true

# Google Gemini API Key for AI Analysis
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# AI Model Configuration
AI_MODEL=gemini-2.0-flash-exp
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# AI Rate Limiting (milliseconds between API calls)
# Default: 4500ms (13 requests/minute, under 15 RPM limit)
# Adjust based on your Gemini API tier
AI_RATE_LIMIT_MS=4500

# AI Confidence Threshold (0-100)
# Stocks with confidence below this will be flagged for manual review
AI_CONFIDENCE_THRESHOLD=70
