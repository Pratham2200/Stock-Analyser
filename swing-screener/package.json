{
  "name": "swing-screener",
  "version": "1.0.0",
  "description": "Automated swing trading stock screener with real-time tracking and technical analysis.",
  "main": "src/main.ts",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nodemon --exec ts-node src/main.ts",
    "build": "tsc",
    "build:client": "cd client && npm run build",
    "dev:client": "cd client && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "db:setup": "psql -d stock_analysis -f database/schema.sql",
    "db:migrate": "psql -d stock_analysis -f database/schema.sql"
  },
  "engines": {
    "node": "20.18.0"
  },
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.8",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "pg": "^8.16.3",
    "puppeteer": "^21.11.0",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^2.5.10"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/helmet": "^0.0.48",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
